# Copy to backend/.env

# Optional. With a key the agent is an LLM using tool calling and can build a
# research framework for any industry. Without it, a rule-based planner covers
# the solar and agriculture scenarios using the same tools.
# You can also leave this empty and paste the key in the app (gear icon). Never commit the real .env.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Sample points per country for NASA POWER (1 = label point only). More points
# give a better country mean but multiply the number of API requests.
POWER_SAMPLES_PER_COUNTRY=3
# Above this many candidate countries, only one point per country is sampled.
POWER_FULL_SAMPLING_MAX_COUNTRIES=60
# SoilGrids is rate limited, so soil data is fetched for this many top candidates only.
SOIL_SHORTLIST=6

ALLOWED_ORIGINS=http://localhost:3000
