# Server only. Copy to .env.local; never prefix secrets with VITE_.
NASA_API_KEY=
# Claude (Sonnet 5.5 by default). Leave empty to reuse the key saved in Meridian (earth/backend/.env).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
