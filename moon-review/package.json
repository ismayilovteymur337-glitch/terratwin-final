{
  "name": "terratwin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TERRATWIN - planetary terrain intelligence platform (Moon module)",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "data": "tsx scripts/prepare-data.ts",
    "dev": "vite --host --port 5173 --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host --port 4173 --configLoader runner",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
